usdt:$MMTK:ruby_mmtk:process_obj_free_candidates {
    if (@enable_print) {
        printf("process_obj_free_candidates,meta,%d,%lu,%lu,%lu\n", tid, nsecs, arg0, arg1);
    }
}

usdt:$MMTK:ruby_mmtk:process_weak_references {
    if (@enable_print) {
        printf("process_weak_references,meta,%d,%lu,%lu,%lu\n", tid, nsecs, arg0, arg1);
    }
}

usdt:$MMTK:ruby_mmtk:pin_pinning_children {
    if (@enable_print) {
        printf("pin_pinning_children,meta,%d,%lu,%lu,%lu,%lu\n", tid, nsecs, arg0, arg1, arg2);
    }
}
